# AgentRecall configuration. Copy to .env for local use.
AGENTRECALL_PG_DSN=postgresql+psycopg://agentrecall:agentrecall@localhost:5433/agentrecall
AGENTRECALL_REDIS_URL=redis://localhost:6380/0

# Retrieval scoring weights (must sum to 1.0 for interpretable scores)
AGENTRECALL_W_SIMILARITY=0.6
AGENTRECALL_W_RECENCY=0.25
AGENTRECALL_W_USAGE=0.15
AGENTRECALL_RECENCY_HALF_LIFE_DAYS=14.0

# Curation thresholds
AGENTRECALL_DEDUP_THRESHOLD=0.94
AGENTRECALL_CONFLICT_THRESHOLD=0.86

# Maintenance
AGENTRECALL_STALE_AFTER_DAYS=90

# Optional: point at any OpenAI-compatible endpoint to replace StubChatModel.
# AGENTRECALL_LLM_BASE_URL=https://api.example.com/v1
# AGENTRECALL_LLM_MODEL=gpt-4o-mini
# AGENTRECALL_LLM_API_KEY=sk-...
